# Copy to apps/api/.env and fill in. .env is gitignored — never commit keys or phone numbers.
# Check what's configured: GET http://localhost:8000/api/voice/status

# --- Gnani (Prisma STT + Timbre TTS) — every call ---
GNANI_API_KEY=

# --- LLM: main + fallback. One key is enough: with only GEMINI_API_KEY set, Gemini is used. ---
LLM_PROVIDER=groq              # groq | google | openai | anthropic
LLM_MODEL=                     # empty = default per provider (groq: llama-3.3-70b-versatile)
LLM_FALLBACK_PROVIDER=google   # empty to disable
LLM_FALLBACK_MODEL=            # empty = a second model of the same provider (google: gemini-3.6-flash)
GROQ_API_KEY=
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_API_KEY=                 # optional: overrides the key for LLM_PROVIDER

# --- Telephony: Twilio trial now (step 6) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=            # +1..., India enabled in Voice Geo Permissions

# --- Telephony: Exotel when credentials arrive ---
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com   # api.in.exotel.com for the Mumbai cluster
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=                    # App Bazaar flow with the Voicebot applet

# --- Public URL for Twilio/Exotel webhooks + media WebSocket (ngrok http 8000) ---
PUBLIC_BASE_URL=

# --- Database (docker compose Postgres on :5434) ---
FORMS_DATABASE_URL=postgresql+psycopg://forms:forms@localhost:5434/forms

# --- Optional voice tuning (app/voice/config.py) ---
# VOICE_EN=Nalini
# VOICE_HI=Nalini
# STT_AUTO_LANGUAGE=false        # true: Prisma v3.0 indic-auto, respondents may switch language mid-sentence
# STT_LANGUAGES=en-IN,hi-IN,ta-IN  # 2-4 languages auto-detection listens for
# STT_FORMAT=transcribe           # or codemix (English stays in Latin script; numbers as words)
# SURVEY_ORG=the research team
# VAD_STOP_SECS=0.8

# Public demo (/demo). DEMO_ONLY hides every other route, for sharing through a tunnel.
# FORMS_DEMO_ONLY=false
# FORMS_DEMO_MAX_CALLS=3
